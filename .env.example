# =============================================================================
# SwiftDrop — Environment Variable Reference
# =============================================================================
# Copy this file to `.env` and fill in real values for local development:
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real credentials.
#
# WARNING: Any variable prefixed with `VITE_` is bundled into the browser
# build and is PUBLICLY VISIBLE to anyone who opens the app. Never put
# server secrets (private keys, service-account JSON, etc.) in a VITE_* var.
# =============================================================================


# -----------------------------------------------------------------------------
# Server (Node/Express — loaded via dotenv in server.ts)
# -----------------------------------------------------------------------------

# NODE_ENV: Runtime mode for the Express server.
#   development (default) — mounts the Vite dev middleware with HMR off.
#   production            — serves the pre-built static bundle from dist/.
# Example: NODE_ENV="development"

# PORT: TCP port the Express server listens on (used in both dev and
# production). Optional — defaults to 3000 when unset. Must be an integer
# between 1 and 65535; the server refuses to start on an invalid value.
# Example: PORT="8080"
PORT="3000"


# -----------------------------------------------------------------------------
# Build-time defines (injected by vite.config.ts)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: API key for Gemini AI features.
# In AI Studio this is injected automatically from the Secrets panel at
# runtime — you do NOT need to set it there. For local dev, create a key at
# https://aistudio.google.com/apikey and set it here.
# It is compiled into the client bundle via vite `define`, so treat it as
# public; restrict the key with HTTP referrer / API restrictions in Google
# Cloud Console.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# -----------------------------------------------------------------------------
# Platform-injected (AI Studio hosting — do NOT set these locally)
# -----------------------------------------------------------------------------

# APP_URL: The public URL where this applet is hosted.
# AI Studio injects this automatically with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# APP_URL="MY_APP_URL"

# DISABLE_HMR: Set by AI Studio to disable Vite HMR/file-watching during
# agent edits. Setting it yourself can cause the preview to flicker.
# DISABLE_HMR="true"


# -----------------------------------------------------------------------------
# Access control (client bundle — public)
# -----------------------------------------------------------------------------

# VITE_ADMIN_EMAILS: Comma-separated list of email addresses automatically
# granted the ADMIN role at sign-in. Matching is case-insensitive.
# If unset, the app falls back to the built-in defaults shown below
# (see src/components/FirebaseProvider.tsx and CompanyOnboarding.tsx).
VITE_ADMIN_EMAILS="tenantsitsolutions@gmail.com,jonathanigimoh@gmail.com"


# -----------------------------------------------------------------------------
# Firebase client configuration (client bundle — public)
# -----------------------------------------------------------------------------
# All of these are OPTIONAL overrides. When left empty, the app falls back
# to the values in firebase-applet-config.json (see src/lib/firebase.ts).
# Set them only when pointing the app at a different Firebase project,
# e.g. a self-hosted production deployment.
#
# NOTE: Firebase client config is not secret — security is enforced by
# firestore.rules and Firebase Auth, not by hiding these values.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Firestore database ID — only needed for named (non-"(default)") databases.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
