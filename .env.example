# Copy to .env and fill in values before running docker compose
# Never commit .env to version control

# PostgreSQL password for TimescaleDB and the API service
POSTGRES_PASSWORD=changeme

# Optional Slack incoming webhook for check alerts.
# Leave blank to disable Slack delivery.
SLACK_WEBHOOK_URL=

# Optional API key. Leave blank for local unauthenticated development.
API_AUTH_KEY=

# Per-IP request limit for protected endpoints.
RATE_LIMIT_PER_MINUTE=120
